# ---------------------------------------------------------------------------
# Local development. See README.zh-CN.md for startup instructions.
# ---------------------------------------------------------------------------

# "dev" (default) or "prod". prod refuses to start without JWT auth, a real
# verification key, Postgres and Redis.
ENV=dev

# Auth: "dev" exposes POST /api/dev/token so the demo UI can act as any seeded
# customer. Production uses "jwt" with tokens issued by your site. "demo" is the
# public sandbox (anonymous visitors get a throwaway customer).
AUTH_MODE=dev
# JWT_SECRET=            # HS256 shared secret (≥32 random bytes), or:
# JWT_JWKS_URL=          # your IdP's JWKS endpoint (RS256/ES256)
# JWT_ISSUER=
# JWT_AUDIENCE=

# Which LLM provider the agent uses: "anthropic", "openai", "gemini",
# "omniroute" (any OpenAI-compatible proxy), or "fake" (scripted, no key
# needed — used for local development and evals).
LLM_PROVIDER=anthropic
# Used when the primary fails (pods skip a failed primary for 30 s):
# LLM_FALLBACK_PROVIDER=gemini

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OpenAI-compatible proxy (e.g. OmniRoute). The model id sets the reasoning
# level; the eval tone judge uses the cheaper OMNIROUTE_JUDGE_MODEL.
# OMNIROUTE_BASE_URL=http://<host>:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=cx/gpt-5.6-sol-medium
# OMNIROUTE_JUDGE_MODEL=cx/gpt-5.6-luna-low

# Storage. For a local `uvicorn` run you can leave these unset:
# SQLite + an in-process Redis stand-in
# are used (single process only), and SEED_ON_STARTUP creates the demo data.
# DATABASE_URL=postgresql://acme:acme@localhost:5432/acme
# REDIS_URL=redis://localhost:6379/0
# SEED_ON_STARTUP=true

# --- Request, cost and runtime limits. All optional; defaults shown. ---
# MAX_MESSAGE_CHARS=2000
# MAX_CONVERSATION_TURNS=30
# MAX_CONVERSATION_TOKENS=60000
# CUSTOMER_DAILY_TOKEN_BUDGET=300000
# AGENT_RECURSION_LIMIT=12
# MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_LIMIT=10/minute          # per customer
# MAX_CONCURRENT_TURNS=200           # global back-pressure (503 beyond this)
# TURN_TIMEOUT_S=120

# --- Tracing + cost dashboards with Opik (optional). ---
# OPIK_URL_OVERRIDE=                  # existing self-hosted Opik API, if available
# Comet-hosted (https://www.comet.com/opik):
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=refund-agent

# --- Public demo (AUTH_MODE=demo). Defaults shown. ---
# DEMO_SESSION_RATE_LIMIT=5/hour     # new sandboxes per client IP
# DEMO_TOKEN_TTL_S=7200
# DEMO_DATA_TTL_HOURS=24             # purge by the retention job
# DEMO_GLOBAL_DAILY_TOKEN_BUDGET=0   # 0 = no cap; then turns use the scripted model
# TURNSTILE_SECRET=                  # optional Cloudflare Turnstile bot check
# TRUSTED_PROXY_HOPS=0               # proxies appending X-Forwarded-For (Cloud Run: 1)

# --- Frontend build (Vite) ---
# VITE_API_BASE_URL=                 # backend origin if the UI is hosted elsewhere
