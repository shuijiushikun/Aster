# Aster 本地配置：复制到 backend/.env，并在 backend 目录运行 Python 命令。
# 完整演示需要 PostgreSQL、Redis 和独立的 Qdrant 知识集合。
ENV=dev
AUTH_MODE=dev
SEED_ON_STARTUP=false

# 主对话模型。密钥仅保存在本机 backend/.env。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# 可选备用模型，设置后同时填写对应供应商的 API Key。
# LLM_FALLBACK_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# 本地轻量意图分类；关闭或故障时使用保守规则。
INTENT_CLASSIFIER_ENABLED=true
INTENT_CLASSIFIER_URL=http://127.0.0.1:11434
INTENT_CLASSIFIER_MODEL=qwen2.5:3b
INTENT_CLASSIFIER_TIMEOUT_S=15

# 使用自己创建的数据库、账号和密码；索引与 API 使用同一份配置。
DATABASE_URL=postgresql://aster:your-password@127.0.0.1:5432/aster
REDIS_URL=redis://127.0.0.1:6379/0

# API 与 MCP 共用独立签名密钥。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
COMMERCE_MCP_URL=http://127.0.0.1:8001/mcp
COMMERCE_MCP_SERVICE_SECRET=
COMMERCE_MCP_TIMEOUT_S=30
COMMERCE_MCP_MAX_RETRIES=1

# 百炼 Embedding 与 Qdrant；集合只用于本项目。
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_DIMENSION=1024
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=after_sales_knowledge_bm25_v1
RAG_SEARCH_MODE=hybrid
RAG_RERANK_ENABLED=true
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_TIMEOUT_S=20
# 建立索引后运行独立校准集，分别填写建议阈值。
# Dense 为 0 时不按向量分数拒答；BM25 为 0 时只参与排名融合。
RAG_MIN_DENSE_SCORE=0
RAG_MIN_BM25_SCORE=0
RERANK_MODEL=qwen3-rerank
# 为空时复用 EMBED_API_KEY；不同区域需对应修改服务地址。
RERANK_API_KEY=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 工具循环、上下文预算与工作流。
AGENT_V2_ENABLED=true
AGENT_MAX_TOOL_CALLS=8
AGENT_RECURSION_LIMIT=24
CONTEXT_MAX_CHARS=14000
CONTEXT_EVIDENCE_MAX_CHARS=1200
SUMMARY_TIMEOUT_S=8
SUMMARY_MAX_CHARS=1600
WORKFLOW_TIMEOUT_S=30
WORKFLOW_POOL_SIZE=4
RETURN_WINDOW_DAYS=30
EXCHANGE_WINDOW_DAYS=30
ESCALATION_THRESHOLD=500

# 可按实际使用调整的运行边界。
# MAX_MESSAGE_CHARS=2000
# MAX_CONVERSATION_TURNS=30
# MAX_CONVERSATION_TOKENS=60000
# CUSTOMER_DAILY_TOKEN_BUDGET=300000
# CHAT_RATE_LIMIT=10/minute
# MAX_CONCURRENT_TURNS=200
# TURN_TIMEOUT_S=120

# 外部部署使用 ENV=prod、AUTH_MODE=jwt 和正式签名配置。
# JWT_SECRET=
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=
# CORS_ORIGINS=https://your-site.example

# 可选追踪。日志不记录模型密钥，Opik 项目使用独立名称。
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=aster
# OPIK_URL_OVERRIDE=

# 前后端使用不同域名时，在 frontend 的构建环境中设置。
# VITE_API_BASE_URL=https://your-api.example
