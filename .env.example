# ---------------------------------------------------------------------------
# Local development. See README.zh-CN.md for startup instructions.
# ---------------------------------------------------------------------------

# "dev" (default) or "prod". prod refuses to start without JWT auth, a real
# verification key, Postgres and Redis.
ENV=dev

# Auth: "dev" exposes POST /api/dev/token so the demo UI can act as any seeded
# customer. Production uses "jwt" with tokens issued by your site. "demo" is the
# public sandbox (anonymous visitors get a throwaway customer).
AUTH_MODE=dev
# JWT_SECRET=            # HS256 shared secret (≥32 random bytes), or:
# JWT_JWKS_URL=          # your IdP's JWKS endpoint (RS256/ES256)
# JWT_ISSUER=
# JWT_AUDIENCE=

# Which LLM provider the agent uses: "anthropic", "openai", "gemini", "deepseek",
# "omniroute" (any OpenAI-compatible proxy), or "fake" (scripted, no key
# needed — used for local development and evals).
LLM_PROVIDER=deepseek
# Used when the primary fails (pods skip a failed primary for 30 s):
# LLM_FALLBACK_PROVIDER=gemini

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# DeepSeek：2026-10-21 官方文档列出的 deepseek-flash，显式关闭思考模式。
# 支持普通回复、工具调用、JSON mode、流式输出；真实能力需独立 smoke 验证。
# 结构化调用使用 with_structured_output(..., method="json_mode")，并在提示词
# 中提供 JSON 示例；不使用 OpenAI 默认 json_schema 或 beta strict 工具模式。
# https://api-docs.deepseek.com/guides/tool_calls/
# https://api-docs.deepseek.com/guides/json_mode/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 独立真实调用：在 backend 目录运行 python -m scripts.deepseek_smoke --live
# OpenAI-compatible proxy (e.g. OmniRoute). The model id sets the reasoning
# level; the eval tone judge uses the cheaper OMNIROUTE_JUDGE_MODEL.
# OMNIROUTE_BASE_URL=http://<host>:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=cx/gpt-5.6-sol-medium
# OMNIROUTE_JUDGE_MODEL=cx/gpt-5.6-luna-low

# Storage. For a local `uvicorn` run you can leave these unset:
# SQLite + an in-process Redis stand-in
# are used (single process only), and SEED_ON_STARTUP creates the demo data.
# DATABASE_URL=postgresql://acme:acme@localhost:5432/acme
# REDIS_URL=redis://localhost:6379/0
# SEED_ON_STARTUP=true

# 本地只读商城 MCP（与后端同一 .env；不要复用前端 JWT/模型 Key）。
COMMERCE_MCP_URL=http://127.0.0.1:8001/mcp
# 生成一次独立共享密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
COMMERCE_MCP_SERVICE_SECRET=
COMMERCE_MCP_TIMEOUT_S=5
COMMERCE_MCP_MAX_RETRIES=1

# 售后知识库：独立集合，不复用其他项目的 collection。
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_DIMENSION=1024
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=after_sales_knowledge_v1
RAG_SEARCH_MODE=hybrid
RAG_RERANK_ENABLED=true
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_TIMEOUT_S=20
# 0 表示尚未校准；先运行独立校准样本，不把余弦阈值迁移到其他模型。
RAG_MIN_DENSE_SCORE=0
RERANK_MODEL=qwen3-rerank
# 空值复用百炼 EMBED_API_KEY；区域不同须同时修改 RERANK_URL。
RERANK_API_KEY=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# --- Request, cost and runtime limits. All optional; defaults shown. ---
# T4 路由与订单/知识代理；false 可退回原退款聊天，业务互斥规则仍保留。
AGENT_V2_ENABLED=true
# 上下文采用字符预算；摘要失败不阻塞正常聊天回复。
CONTEXT_MAX_CHARS=14000
CONTEXT_EVIDENCE_MAX_CHARS=1200
SUMMARY_TIMEOUT_S=8
SUMMARY_MAX_CHARS=1600
# T5 持久化工作流需要 PostgreSQL + Redis；Windows 使用 python -m scripts.serve。
WORKFLOW_TIMEOUT_S=30
WORKFLOW_POOL_SIZE=4
# 换货申请窗口，与原退款窗口独立配置（按工单首次提交时间判断）。
EXCHANGE_WINDOW_DAYS=30
# MAX_MESSAGE_CHARS=2000
# MAX_CONVERSATION_TURNS=30
# MAX_CONVERSATION_TOKENS=60000
# CUSTOMER_DAILY_TOKEN_BUDGET=300000
# AGENT_RECURSION_LIMIT=12
# MAX_OUTPUT_TOKENS=1024
# CHAT_RATE_LIMIT=10/minute          # per customer
# MAX_CONCURRENT_TURNS=200           # global back-pressure (503 beyond this)
# TURN_TIMEOUT_S=120

# --- Tracing + cost dashboards with Opik (optional). ---
# OPIK_URL_OVERRIDE=                  # existing self-hosted Opik API, if available
# Comet-hosted (https://www.comet.com/opik):
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=refund-agent

# --- Public demo (AUTH_MODE=demo). Defaults shown. ---
# DEMO_SESSION_RATE_LIMIT=5/hour     # new sandboxes per client IP
# DEMO_TOKEN_TTL_S=7200
# DEMO_DATA_TTL_HOURS=24             # purge by the retention job
# DEMO_GLOBAL_DAILY_TOKEN_BUDGET=0   # 0 = no cap; then turns use the scripted model
# TURNSTILE_SECRET=                  # optional Cloudflare Turnstile bot check
# TRUSTED_PROXY_HOPS=0               # proxies appending X-Forwarded-For (Cloud Run: 1)

# --- Frontend build (Vite) ---
# VITE_API_BASE_URL=                 # backend origin if the UI is hosted elsewhere
